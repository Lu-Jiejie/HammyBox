{
  "name": "hammybox",
  "version": "2.7.3",
  "type": "module",
  "scripts": {
    "ci-test": "concurrently --kill-others \"npm start\" \"wait-on http://localhost:8080 && mocha\"",
    "ci-test:docker": "concurrently --kill-others \"npm run start:docker\" \"wait-on http://localhost:8080 && mocha\"",
    "test": "mocha",
    "typecheck": "tsc --noEmit",
    "start": "npx wrangler pages dev ./frontend-dist --kv \"hammybox_kv\" --r2 \"hammybox_r2\" --ip 0.0.0.0 --port 8080 --persist-to ./data",
    "start:docker": "node --import ./deploy/server/register.mjs deploy/server/index.js",
    "deploy:worker": "npx tsx deploy/worker/generate-routes.ts && npx wrangler deploy --config deploy/worker/wrangler.toml"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.726.1",
    "@cloudflare/pages-plugin-sentry": "^1.1.3",
    "@sentry/tracing": "^7.114.0",
    "miniflare": "^3.20240718.0"
  },
  "optionalDependencies": {
    "@hono/node-server": "^1.13.8",
    "better-sqlite3": "^11.9.1",
    "hono": "^4.7.4"
  },
  "overrides": {
    "fast-xml-parser": "^5.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "concurrently": "^8.2.2",
    "mocha": "^10.6.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "wait-on": "^7.2.0",
    "wrangler": "^4.24.0"
  }
}
